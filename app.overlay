/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;

&flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(80)>;
		};
		slot0_partition: partition@14000 {
			label = "image-0";
			reg = <0x00014000 DT_SIZE_K(96)>;
		};
		slot1_partition: partition@2c000 {
			label = "image-1";
			reg = <0x0002c000 DT_SIZE_K(96)>;
		};
		storage_partition: partition@44000 {
			label = "storage";
			reg = <0x00044000 DT_SIZE_K(32)>;
		};
	};
};

